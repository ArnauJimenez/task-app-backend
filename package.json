{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/socket-server.js",
  "scripts": {
    "dev": "tsx watch src/socket-server.ts",
    "start": "npm run db:migrate:deploy && node dist/socket-server.js",
    "db:migrate:deploy": "prisma migrate deploy",
    "build": "tsc --skipLibCheck",
    "test": "vitest run src --exclude src/auth.test.ts",
    "test:integration": "vitest run src/auth.test.ts",
    "docker:build": "docker build -t task-management-backend .",
    "docker:run": "docker run -d -p 3000:3000 --env-file .env --name task-backend-instance task-management-backend"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^11.11.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.1.0"
  }
}
