# Copy to .env for local development. In production, set these in Render's
# environment settings instead. Never commit real values.

# Render sets PORT automatically; the server binds to 0.0.0.0:$PORT.
PORT=3000

# PostgreSQL connection string. Neon requires sslmode=require.
# Percent-encode reserved characters in the password.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public

# Required in production (at least 8 characters). Signs login tokens.
JWT_SECRET=replace-with-a-private-secret-at-least-8-characters

# Comma-separated exact frontend origins, e.g. https://your-app.vercel.app
# Wildcards are supported (https://*.preview.example.com) and "*" allows all.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
# Used only when CORS_ORIGIN is empty.
# FRONTEND_URL=

# Primary LLM provider (DeepSeek by default). Values here override the legacy LLM_* variables.
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_BASE_URL=https://api.deepseek.com/v1
PRIMARY_LLM_MODEL=deepseek-chat

# Secondary LLM provider (Groq by default), used when the primary fails or times out.
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_BASE_URL=https://api.groq.com/openai/v1
SECONDARY_LLM_MODEL=openai/gpt-oss-120b

# Legacy single-provider settings, used when the PRIMARY_LLM_* values are empty.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Optional. Error reporting; leave empty to disable.
SENTRY_DSN=
# Optional. Enables the /debug-sentry test route even in production.
# SENTRY_DEBUG_ROUTE_ENABLED=false
# Optional. pino log level (default: info).
# LOG_LEVEL=info
