generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String?  // 👈 Aquí está el campo 'name' que faltaba
  email     String   @unique
  password  String
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?  // El '?' significa que es opcional
  completed   Boolean  @default(false)
  userId      String?  // Opcional por si creas tareas sin usuario asociado de momento
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
}